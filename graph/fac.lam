# fac.lam - 7! by combinator graph reduction (graph.asm).
#
#   ./run fac.lam                                ->  5040
#   python3 lam2graph.py -t fac.lam              (shows the compiled terms)
#
# fac calls itself by name: its cell points back to itself, so recursion
# needs neither Y nor rec. Numbers are 15-bit, so 7! is the largest factorial
# that fits.

fac n = if (= n 0) 1 (* n (fac (- n 1)));

fac 7
