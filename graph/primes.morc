# primes.morc - the 100th prime, from an infinite list of primes, in MORC.
#
#   ./run primes.morc                            ->  541
#
# h : t and nil are lists. A function on lists has one clause for nil and one
# for h : t, and the clauses are tried in order.

fun from n = n : from (n + 1);

fun filter p nil = nil;
fun filter p (h : t) = if p h then h : filter p t else filter p t;

fun sieve nil = nil;
fun sieve (h : t) = h : sieve (filter (\x -> x % h != 0) t);

fun nth _ nil = 0;
fun nth k (h : t) = if k = 0 then h else nth (k - 1) t;

fun primes = sieve (from 2);

fun main = nth 99 primes;
