graph net {
  graph [label="step 5: Dup-Z", labelloc=t, fontname="Helvetica", fontsize=14, nodesep=0.35, ranksep=0.45];
  node [fontname="Helvetica", fontsize=12];
  edge [color="#444444"];
  n2 [shape=plaintext, label="r", fontcolor="#1f5fbf", fontname="Helvetica-Oblique"];
  n0 [shape=invtriangle, label="Fib", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n1 [shape=invtriangle, label="Add", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n3 [shape=invtriangle, label="Fib1", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n4 [shape=triangle, label="S", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n5 [shape=invtriangle, label="Dup", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#f6c9c4"];
  n6 [shape=triangle, label="S", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n7 [shape=triangle, label="Z", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#f6c9c4"];
  n0:s -- n6:n [color="#c0392b", penwidth=2];
  n0:n -- n1:ne [constraint=false];
  n1:s -- n3:n;
  n2 -- n1:nw;
  n3:s -- n4:n [color="#c0392b", penwidth=2];
  n4:s -- n5:nw [constraint=false];
  n5:s -- n7:n [color="#c0392b", penwidth=3];
  n5:ne -- n6:s [constraint=false];
}
