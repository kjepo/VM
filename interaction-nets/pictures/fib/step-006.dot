graph net {
  graph [label="step 7: Fib1-Z", labelloc=t, fontname="Helvetica", fontsize=14, nodesep=0.35, ranksep=0.45];
  node [fontname="Helvetica", fontsize=12];
  edge [color="#444444"];
  n4 [shape=plaintext, label="r", fontcolor="#1f5fbf", fontname="Helvetica-Oblique"];
  n0 [shape=invtriangle, label="Fib1", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n1 [shape=invtriangle, label="Add", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n2 [shape=invtriangle, label="Fib1", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#f6c9c4"];
  n3 [shape=triangle, label="Z", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#f6c9c4"];
  n5 [shape=triangle, label="S", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n6 [shape=triangle, label="Z", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n0:s -- n5:n [color="#c0392b", penwidth=2];
  n1:s -- n0:n;
  n4 -- n1:nw;
  n1:ne -- n2:n [constraint=false];
  n2:s -- n3:n [color="#c0392b", penwidth=3];
  n5:s -- n6:n;
}
