graph net {
  graph [label="step 2: Dup-Lam", labelloc=t, fontname="Helvetica", fontsize=14, nodesep=0.35, ranksep=0.45];
  node [fontname="Helvetica", fontsize=12];
  edge [color="#444444"];
  n0 [shape=plaintext, label="out", fontcolor="#1f5fbf", fontname="Helvetica-Oblique"];
  n1 [shape=invtriangle, label="App", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#e8eef7"];
  n2 [shape=invtriangle, label="Dup1", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#f6c9c4"];
  n3 [shape=triangle, label="Lam", width=0.75, height=0.6, fixedsize=true, margin=0, style=filled, fillcolor="#f6c9c4"];
  n0 -- n1:ne;
  n1:s -- n2:nw;
  n1:nw -- n2:ne [constraint=false];
  n2:s -- n3:n [color="#c0392b", penwidth=3];
  n3:sw -- n3:se [constraint=false];
}
